# ============================================================================
# InterviewMinds Backend Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] enable additional features when configured.
# ============================================================================

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# ─── Database [REQUIRED] ────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# ─── Security [REQUIRED] ────────────────────────────────────────────────────
JWT_SECRET=<generate-a-strong-random-secret-at-least-32-characters>
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Authentication (Clerk) [REQUIRED] ──────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# ─── AI Services [REQUIRED: GROQ] ──────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=

# ─── Azure Speech (TTS/STT) [OPTIONAL] ─────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# ─── Media Storage (Cloudinary) [OPTIONAL] ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Observability [OPTIONAL] ───────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Email Notifications [OPTIONAL] ─────────────────────────────────────────
# Provider: sendgrid | smtp | mailgun (default: sendgrid)
EMAIL_PROVIDER=sendgrid
FROM_EMAIL=noreply@interviewminds.com

# SendGrid
SENDGRID_API_KEY=

# Mailgun (alternative to SendGrid)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SMTP (alternative to SendGrid/Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── SMS Notifications (Twilio) [OPTIONAL] ──────────────────────────────────
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ─── Communication Integrations [OPTIONAL] ──────────────────────────────────
# Slack
SLACK_BOT_TOKEN=

# Microsoft Teams
TEAMS_GRAPH_TOKEN=
TEAMS_TEAM_ID=

# Zoom
ZOOM_JWT_TOKEN=

# ─── Background Checks [OPTIONAL] ───────────────────────────────────────────
IDENTITY_PROVIDER_URL=
BACKGROUND_CHECK_API_URL=
BACKGROUND_CHECK_API_KEY=
EMPLOYMENT_VERIFICATION_URL=
EDUCATION_VERIFICATION_URL=
DRUG_TEST_LAB_NAME=Quest Diagnostics

# ─── Video Call (WebRTC) [OPTIONAL] ─────────────────────────────────────────
# STUN/TURN servers (defaults to Google public STUN if not set)
STUN_SERVER_URL=stun:stun.l.google.com:19302
ADDITIONAL_STUN_URLS=
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# SFU (Selective Forwarding Unit) for large group calls
SFU_ENABLED=false
SFU_PROVIDER=none
SFU_ENDPOINT=
SFU_API_KEY=
SFU_API_SECRET=
SFU_MESH_THRESHOLD=4

# Recording
RECORDING_SERVICE_URL=
RECORDING_STORAGE_PATH=./recordings
RECORDING_FORMAT=webm

# ─── CDN / AWS (S3 + CloudFront) [OPTIONAL] ─────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
